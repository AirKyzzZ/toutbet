# Generate the four secrets with: uv run toutbet-admin gen-secrets >> .env
ENV=dev
DATABASE_URL=sqlite:///./toutbet.db
JWT_SECRET=
RECEIPT_SIGNING_KEY=
PSP_API_KEY=
PSP_WEBHOOK_SECRET=
PSP_BASE_URL=http://127.0.0.1:8001
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=
TRUSTED_PROXY_IPS=127.0.0.1
BET_CREATION_ENABLED=true
STAKES_ENABLED=true
DEPOSITS_ENABLED=true
WITHDRAWALS_ENABLED=true
MOCK_PSP_PUBLIC_URL=http://localhost:8001
MOCK_PSP_WEBHOOK_URL=http://localhost:8000/api/webhooks/psp
# docker compose only, use long random values
POSTGRES_OWNER_PASSWORD=
APP_DB_PASSWORD=
